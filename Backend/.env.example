# Set a long random secret before deployment. Do not commit real secrets.
PSYNS_TOKEN_SECRET=replace-with-a-long-random-secret
# Optional: store database and private files outside the source tree.
# PSYNS_DB_PATH=D:/PSYNS-data/psyns.sqlite3
# PSYNS_UPLOAD_DIR=D:/PSYNS-data/private_uploads

# Optional: enables GPT-style faculty assistant. Keep this key only on the backend.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
